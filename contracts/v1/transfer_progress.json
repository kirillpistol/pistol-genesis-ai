{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:genesis:1:transfer_progress",
  "type": "object",
  "properties": {
    "api_version": {
      "type": "string",
      "const": "1.0"
    },
    "transfer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "phase": {
      "type": "string",
      "enum": [
        "prepared",
        "receiving",
        "ready",
        "released",
        "active",
        "cancelled",
        "aborted"
      ]
    },
    "next_offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    }
  },
  "required": [
    "api_version",
    "transfer_id",
    "phase",
    "next_offset"
  ],
  "additionalProperties": false
}
