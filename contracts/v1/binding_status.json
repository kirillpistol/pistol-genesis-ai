{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:genesis:1:binding_status",
  "type": "object",
  "properties": {
    "api_version": {
      "type": "string",
      "const": "1.0"
    },
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "binding": {
      "type": "object",
      "properties": {
        "passport": {
          "type": "object",
          "properties": {
            "binding_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "level2_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "algorithm_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "model_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "package_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "input_contract": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "level3_manifest_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "data_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "manifest_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "allowed_workers": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "required": [
            "binding_id",
            "level2_id",
            "algorithm_version",
            "model_version",
            "package_sha256",
            "input_contract",
            "level3_manifest_id",
            "data_version",
            "manifest_sha256",
            "allowed_workers"
          ],
          "additionalProperties": false
        },
        "passport_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "next_record": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      },
      "required": [
        "passport",
        "passport_sha256",
        "next_record"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "worker_id",
    "binding"
  ],
  "additionalProperties": false
}
